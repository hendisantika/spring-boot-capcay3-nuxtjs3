# Copy this file to .env and fill in your own value:
#   cp .env.example .env
# Never commit .env (it is git-ignored).

# Google reCAPTCHA v3 SITE key (public key used by the browser)
# Create one at https://www.google.com/recaptcha/admin/create
NUXT_PUBLIC_GOOGLE_RECAPTCHA_KEY=your-recaptcha-v3-site-key
