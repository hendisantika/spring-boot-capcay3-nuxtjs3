# Backend environment variables
# Copy this file to .env in the project root and fill in your own value:
#   cp .env.example .env
# Never commit .env (it is git-ignored).
#
# Spring Boot loads ./.env through spring.config.import (see application.properties).
# A real OS environment variable with the same name takes precedence over this file.

# Google reCAPTCHA v3 SECRET key (server-side, keep it private)
# Create one at https://www.google.com/recaptcha/admin/create
GOOGLE_RECAPTCHA_SECRET=your-recaptcha-v3-secret-key
